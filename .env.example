SEARCH_ENVIRONMENT=development
SEARCH_DATA_PATH=data/sample_documents.jsonl
SEARCH_ARTIFACT_DIR=artifacts/index/current
SEARCH_DATABASE_PATH=artifacts/search.db
# For multi-replica production: postgresql+psycopg://user:password@host:5432/search
SEARCH_DATABASE_URL=
SEARCH_EMBEDDING_MODEL=hashing
SEARCH_INDEX_TYPE=flat
SEARCH_HYBRID_ALPHA=0.55
SEARCH_CANDIDATE_K=50
SEARCH_MAX_TOP_K=50
SEARCH_RERANKER_MODEL=
SEARCH_API_KEY=
SEARCH_RETAIN_QUERY_TEXT=false
